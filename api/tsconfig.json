{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext", 
    "moduleResolution": "nodenext",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*", "prisma.config.ts",],
  "exclude": ["node_modules"]
}