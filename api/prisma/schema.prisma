generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  username  String?
  dob       DateTime @map("date_of_birth")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}